# ============================================================================
# FONTES DE DADOS
# Os três drivers são independentes. A virada acontece uma fonte por vez —
# nunca as três no mesmo dia — e cada uma vira o próprio "mock" em "real".
# O painel do gestor mostra qual está ligado em cada momento.
# ============================================================================

# ---- ERP RP ----
# mock = lê os JSONs de /mock_erp (padrão, funciona sem nenhuma credencial)
# rp   = ERP real. Só funciona depois da Fase 0 (ver src/lib/erp/rp-client.ts)
ERP_DRIVER=mock
ERP_BASE_URL=
ERP_TOKEN=

# ---- ALVO (metas, campanhas, crédito) ----
# mock = lê /mock_integracoes/alvo_*.json
# http = ALVO real (ver src/lib/integracoes/alvo/alvo-client.ts)
ALVO_DRIVER=mock
ALVO_BASE_URL=
ALVO_TOKEN=

# ---- Rota Exata (roteiro do dia, frequência de visita) ----
# mock = lê /mock_integracoes/rota_*.json
# http = Rota Exata real (ver src/lib/integracoes/rota-exata/rota-exata-client.ts)
ROTA_DRIVER=mock
ROTA_BASE_URL=
ROTA_TOKEN=

# ---- Banco ----
DATABASE_URL="postgresql://usuario:senha@localhost:5432/ribercon"

# ---- Web Push (gerar com: npx web-push generate-vapid-keys) ----
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@ribercon.com.br

# ============================================================================
# MOTOR
# Lidos em src/lib/config.ts. Valor inválido derruba a aplicação no boot, de
# propósito: motor rodando com parâmetro errado é pior que motor não rodando.
# ============================================================================

# dias de antecedência do alerta de recompra
LEAD_TIME_DIAS=5

# máximo de cards por vendedor por dia — leia a seção 5.4 do doc antes de mexer
TAMANHO_FILA=10
